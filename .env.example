# ── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database (Neon Postgres) ───────────────────────────
# DATABASE_URL: pooled connection (host has "-pooler") — used by the app at runtime
# DIRECT_URL:   direct connection (no "-pooler")        — used by `prisma migrate`
# Grab both from Neon dashboard → Connect → "Prisma" preset, then set
# sslmode=verify-full (Neon certs are publicly trusted; avoids a node-postgres warning).
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=verify-full"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=verify-full"

# ── Auth ───────────────────────────────────────────────
# Secret used to sign JWTs. Generate one with: openssl rand -hex 32
SECRET="replace_with_a_random_32_byte_hex_string"

# ── Email / SMTP ───────────────────────────────────────
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER="you@example.com"
EMAIL_SMTP_PASS="your_smtp_app_password"
EMAIL_SMTP_SERVICE_NAME="Zoho"

# ── Frontend ───────────────────────────────────────────
# Origin of the frontend app — used for CORS and activation links
CLIENT_HOST="http://localhost:3001"

# ── Cloudinary ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"